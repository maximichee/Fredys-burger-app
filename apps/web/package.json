{
  "name": "@fredys/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "fotos": "node scripts/optimizar-fotos.mjs",
    "prebuild": "node scripts/optimizar-fotos.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrar": "prisma migrate deploy",
    "db:cargar": "node prisma/seed.mts"
  },
  "dependencies": {
    "@fredys/types": "workspace:*",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "framer-motion": "^11.11.0",
    "gsap": "3.13.0",
    "jose": "5.9.6",
    "lenis": "1.3.11",
    "next": "15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.mts"
  }
}
